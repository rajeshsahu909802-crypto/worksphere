{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Java: Compile and Run",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "javac ${file} && java ${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Java: Compile Only",
            "type": "shell",
            "command": "javac",
            "args": ["${file}"],
            "problemMatcher": ["$javac"],
            "presentation": {
                "reveal": "always",
                "focus": true
            }
        },
        {
            "label": "Java: Run",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "java ${fileBasenameNoExtension}"
            ],
            "presentation": {
                "reveal": "always",
                "focus": true
            }
        }
    ]
}
